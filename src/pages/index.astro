---
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryList from '../components/EntryList.astro';
import { getEntries } from '../lib/content';
const [writing, caseStudies] = await Promise.all([getEntries('writing'), getEntries('caseStudies')]);
---

<BaseLayout>
  <section class="intro" aria-labelledby="intro-title">
    <p class="eyebrow">Distributed systems · Rust · ZK rollups</p>
    <h1 id="intro-title">Martin Ondejka<span class="accent">.</span></h1>
    <p class="intro-description">I’m a distributed systems engineer working on Rust and zero-knowledge rollups.</p>
    <p class="intro-context">Founding engineer and CTO at Zeko. This is where I write about the systems I work on and the decisions behind them.</p>
    <a class="text-link" href="/about/">More about me <span aria-hidden="true">↗</span></a>
  </section>

  <section class="content-section" aria-labelledby="writing-title">
    <div class="section-heading"><h2 id="writing-title">Writing</h2><a href="/writing/">All writing <span aria-hidden="true">↗</span></a></div>
    <EntryList entries={writing.slice(0, 3)} headingLevel="h3" emptyTitle="No articles yet." emptyDescription="Notes on systems, code, and the details that matter." />
  </section>
  <section class="content-section" aria-labelledby="studies-title">
    <div class="section-heading"><h2 id="studies-title">Case studies</h2><a href="/case-studies/">All case studies <span aria-hidden="true">↗</span></a></div>
    <EntryList entries={caseStudies.slice(0, 3)} headingLevel="h3" emptyTitle="No case studies yet." emptyDescription="A closer look at engineering problems and how I approached them." />
  </section>
</BaseLayout>
