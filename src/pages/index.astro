---
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryList from '../components/EntryList.astro';
import { getEntries } from '../lib/content';
const writing = await getEntries();
---

<BaseLayout>
  <section class="intro" aria-labelledby="intro-title">
    <p class="eyebrow">Distributed systems · Rust · ZK rollups</p>
    <h1 id="intro-title">Martin Ondejka<span class="accent">.</span></h1>
    <p class="intro-description">I’m a distributed systems engineer working on Rust and zero-knowledge rollups.</p>
    <p class="intro-context">Founding engineer and CTO at Zeko. This is where I write about the systems I work on and the decisions behind them.</p>
    <a class="text-link" href="/about/">More about me <span aria-hidden="true">↗</span></a>
  </section>

  <section class="content-section" aria-labelledby="writing-title">
    <div class="section-heading"><h2 id="writing-title">Writing</h2><a href="/writing/">All writing <span aria-hidden="true">↗</span></a></div>
    <EntryList entries={writing.slice(0, 3)} headingLevel="h3" emptyTitle="No posts yet." emptyDescription="Notes and case studies on systems, code, and the decisions behind them." />
  </section>
</BaseLayout>
