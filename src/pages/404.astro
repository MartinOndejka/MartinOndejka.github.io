---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
  <header class="page-heading">
    <p class="eyebrow">404</p>
    <h1>Page not found<span class="accent">.</span></h1>
    <p>This address doesn’t lead to a page. It may have moved, or the link may be incomplete.</p>
  </header>
  <div class="page-list"><a class="text-link" href="/">← Back to the homepage</a></div>
</BaseLayout>
