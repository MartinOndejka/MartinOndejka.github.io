---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryList from '../../components/EntryList.astro';
import { getEntries } from '../../lib/content';
const entries = await getEntries();
---

<BaseLayout title="Writing" description="Notes and case studies on distributed systems and protocols in OCaml, Rust, and C++ by Martin Ondejka.">
  <header class="page-heading">
    <p class="eyebrow">Notes & case studies</p>
    <h1>Writing<span class="accent">.</span></h1>
    <p>On systems, code, and the decisions behind them.</p>
  </header>
  <div class="page-list"><EntryList entries={entries} emptyTitle="No posts yet." /></div>
</BaseLayout>
