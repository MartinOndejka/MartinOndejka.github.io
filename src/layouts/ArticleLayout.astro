---
import BaseLayout from './BaseLayout.astro';
import { formatDate, type Entry } from '../lib/content';

interface Props { entry: Entry }
const { entry } = Astro.props;
const isWriting = entry.collection === 'writing';
const section = isWriting ? 'Writing' : 'Case studies';
const sectionUrl = isWriting ? '/writing/' : '/case-studies/';
---

<BaseLayout title={entry.data.title} description={entry.data.summary} noindex={entry.data.draft}>
  <article>
    {entry.data.draft && <aside class="draft-notice">Draft preview — visible only in local development.</aside>}
    <header class="article-header">
      <p class="eyebrow"><a href={sectionUrl}>{section}</a></p>
      <h1>{entry.data.title}</h1>
      <p class="article-meta"><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time> · Martin Ondejka</p>
      <p class="article-summary">{entry.data.summary}</p>
    </header>
    <div class="prose"><slot /></div>
    <div class="article-back"><a href={sectionUrl}>← Back to {section.toLowerCase()}</a></div>
  </article>
</BaseLayout>
